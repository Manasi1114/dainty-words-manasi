---
const { title, description = "My website description" } = Astro.props;
import Button from "../components/Button.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/svg/favicon.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <title>{title}</title>
    <slot name="head" />
  </head>

  <body>
    <!-- Top Right Archive Navigation -->
    <header class="archive-nav" id="archive-nav">
      <!-- Menu button: only shows on phones (see "Phones" styles below) -->
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
        Menu
      </button>
      <nav class="nav-links" id="nav-links" aria-label="Main">
        <a href="/" class="archive-box">Home</a>
        <a href="/projects" class="archive-box">Projects</a>
        <a href="/blog" class="archive-box">Blog</a>
        <a href="/poetry" class="archive-box">Poetry</a>
        <a href="/quotes" class="archive-box">Quotes</a>
        <a href="/bookhouse" class="archive-box">Bookhouse</a>
        <a href="/magazine" class="archive-box">Magazine</a>
        <a href="/design-source-catalogue" class="archive-box">Design Catalogue</a>
        <a href="/design" class="archive-box">Design Notes</a>
        <a href="/about" class="archive-box">About</a>
        <a href="/socials" class="archive-box">Connect</a>
        <a href="/sitemap" class="archive-box">Sitemap</a>
      </nav>
    </header>
    <script is:inline>
      // Opens and closes the phone menu. Without JavaScript the links simply stay visible.
      (function () {
        var nav = document.getElementById("archive-nav");
        var btn = nav.querySelector(".nav-toggle");
        nav.classList.add("js-ready");
        btn.addEventListener("click", function () {
          var open = nav.classList.toggle("open");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          btn.textContent = open ? "Close" : "Menu";
        });
      })();
    </script>

    <main class="main-content">
      <slot />
    </main>
  </body>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #aed1c7;
      min-height: 100vh;
      position: relative;
      font-family: sans-serif;
    }

    /* =========================
       Archive Navigation
       ========================= */

    .archive-nav {
      position: absolute;
      top: 40px;
      right: 40px;
      z-index: 10;
    }

    .nav-links {
      display: grid;
      grid-template-columns: repeat(4, auto);
      gap: 14px;
    }

    .nav-toggle {
      display: none;
    }

.archive-box {
  padding: 10px 18px;
  border: 1.5px solid #05162e;
  border-radius: 10px;
  text-decoration: none;
  font-size: 14px;
  color: #05162e;
  background-color: transparent;
  white-space: nowrap;
}

.archive-box:hover {
  background-color: #89023e; /* solid maroon */
  border-color: #220612;
  color: #ffffff; /* white text */
  transform: translateY(-6px);
}



    .archive-box:hover {
      background: rgba(5, 22, 46, 0.08);
      transform: translateY(-1px);
    }

    /* =========================
       Main Content
       ========================= */

    .main-content {
      max-width: 900px;
      margin: 0 auto;
      padding: 200px 20px 60px; /* leaves room for the 3 rows of buttons */
    }

    /* =========================
       Responsive Adjustments
       ========================= */

    /* Tablets: buttons become one centred, wrapping row above the content */
    @media (max-width: 1024px) {
      .archive-nav {
        position: relative;
        top: auto;
        right: auto;
        padding: 20px 16px 0;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
      }

      .main-content {
        padding-top: 32px;
      }
    }

    /* Phones: buttons fold away behind a Menu button */
    @media (max-width: 768px) {
      .archive-nav {
        padding: 16px 16px 0;
      }

      .nav-toggle {
        display: inline-flex;
        align-items: center;
        min-height: 44px; /* comfortable tap size */
        padding: 10px 18px;
        border: 1.5px solid #05162e;
        border-radius: 10px;
        background: transparent;
        color: #05162e;
        font-size: 15px;
        cursor: pointer;
      }

      .archive-nav.js-ready .nav-links {
        display: none;
      }

      .archive-nav.js-ready.open .nav-links,
      .nav-links {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 12px;
      }

      .archive-box {
        text-align: center;
        padding: 12px 10px;
        font-size: 15px;
      }

      .main-content {
        padding: 24px 16px 48px;
      }
    }
  </style>
</html>
