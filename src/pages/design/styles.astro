    background: repeating-conic-gradient(from 0deg, transparent 0 7deg, rgba(216,182,90,.55) 7deg 8deg);
    -webkit-mask: radial-gradient(circle, transparent 54%, #000 55%, #000 62%, transparent 63%, transparent 66%, #000 67%, #000 68%, transparent 69%);
    mask: radial-gradient(circle, transparent 54%, #000 55%, #000 62%, transparent 63%, transparent 66%, #000 67%, #000 68%, transparent 69%); }
