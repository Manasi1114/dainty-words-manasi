  .sp-bauhaus .sqr { position: absolute; right: 8%; top: 22%; width: 30cqw; height: 30cqw; background: #1f4ea1; }
  .sp-bauhaus .tri { position: absolute; left: 30%; bottom: 14%; width: 0; height: 0; border-left: 16cqw solid transparent; border-right: 16cqw solid transparent; border-bottom: 26cqw solid #f2c81b; }
