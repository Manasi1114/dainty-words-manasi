  .sp-ethereal .v1 { width: 70%; height: 50%; left: -10%; top: 10%; background: rgba(214,196,240,.7); }
  .sp-ethereal .v2 { width: 60%; height: 45%; right: -10%; bottom: 8%; background: rgba(255,214,200,.7); }
