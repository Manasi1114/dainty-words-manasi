  .sp-anthropomorphic .handle { position: absolute; right: -16cqw; top: 18%; width: 14cqw; height: 22cqw; border: 1.6cqw solid #1b1b1b; border-left: 0; border-radius: 0 10cqw 10cqw 0; }

