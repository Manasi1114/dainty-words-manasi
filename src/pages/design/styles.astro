---
// A Field Guide to Design Styles
// Style names and traits: UX Planet (credited on the page). Specimens are drawn in code for this page.
import MainLayout from "../../layouts/MainLayout.astro";
import { STYLES, GROUPS, SOURCE } from "../../data/design-styles.js";
import { IMAGES, tileSrc } from "../../data/design-style-images.js";

const nameOf = Object.fromEntries(STYLES.map((s) => [s.id, s.name]));

const groupName = Object.fromEntries(GROUPS.map((g) => [g.id, g.name]));
const byGroup = GROUPS.map((g) => ({ ...g, items: STYLES.filter((s) => s.group === g.id).sort((a, b) => a.n - b.n) }));
const az = [...STYLES].sort((a, b) => a.name.localeCompare(b.name));
const fonts =
  "family=Gloock&family=League+Gothic&family=Josefin+Sans:wght@300;400;600&family=Courier+Prime:wght@400;700" +
  "&family=Cinzel:wght@500;700&family=Bodoni+Moda:opsz,wght@6..96,500&family=Poiret+One&family=UnifrakturMaguntia" +
  "&family=Press+Start+2P&family=VT323&family=Rye&family=Fredoka:wght@600&family=Cormorant+Garamond:ital,wght@0,400;1,300;1,500" +
  "&family=IM+Fell+English:ital@0;1&family=Allerta+Stencil&family=Sedgwick+Ave+Display&family=Archivo+Black&family=Space+Mono" +
  "&family=Pinyon+Script&family=Monoton&family=Bungee&family=Caveat:wght@500&display=swap";
---

<MainLayout
  title="Field Guide – Design Styles · Dainty Archive"
  description="A visual vocabulary for recognising, exploring and combining design languages: 50 styles with specimens, references and reusable prompts."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}`} />
  </Fragment>

  <div class="fg" id="top">
    <header class="fg-cover">
      <div class="fg-side">
        <a class="fg-back" href="/">Dainty Archive</a>
        <span class="fg-meta"><b>50 styles</b>in five families</span>
        <span class="fg-meta"><b>Updated</b>October 2026</span>
        <span class="fg-meta fg-xlink"><b>See also</b><a href="/design-source-catalogue">Design Source Catalogue</a></span>
      </div>
      <div class="fg-main">
        <div class="fg-tblock">
          <h1><span>Field Guide</span><span>Design Styles</span></h1>
          <p class="fg-sub">A visual vocabulary for recognising, exploring, and combining design languages.</p>
        </div>
        <section class="fg-azbox" aria-label="Jump to a style">
          <span class="fg-azbox-h">Jump to a style</span>
          <div class="fg-fams">
            {byGroup.map((g) => (
              <div class="fg-fam">
                <button type="button" class="fg-fam-btn" data-fam={g.id} aria-expanded="false">{g.name}<span class="n">{g.items.length}</span></button>
                <div class="fg-fam-list" hidden>
                  {g.items.map((s) => <a class="fg-az-link" href={`#style-${s.id}`}>{s.name}</a>)}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </header>

    <div class="fg-tools" role="search">
      <label class="fg-search">
        <span class="sr-only">Search styles</span>
        <input id="fg-q" type="search" placeholder="Search a style or trait: gold, grid, pixel…" autocomplete="off" />
      </label>
      <span id="fg-count" class="sr-only" aria-live="polite">50 of 50 styles</span>
    </div>


    <p class="fg-empty" id="fg-empty" hidden>No style matches that search. Try a broader word, pick “All”, or press Reset.</p>

    {byGroup.map((g) => (
      <section class="fg-group" id={`g-${g.id}`} data-group-section={g.id} aria-labelledby={`h-${g.id}`}>
        <div class="fg-group-head">
          <h2 id={`h-${g.id}`}>{g.name}</h2>
          <p>{g.blurb}</p>
          <span class="fg-group-count">{g.items.length} styles</span>
        </div>
        <ul class="fg-grid">
          {g.items.map((s) => (
            <li
              class="fg-tile"
              id={`style-${s.id}`}
              data-id={s.id}
              data-n={s.n}
              data-name={s.name}
              data-group={s.group}
              data-text={`${s.name} ${s.traits} ${s.use}`.toLowerCase()}
            >
              <div class="fg-media">
                <div class={`fg-spec sp-${s.id}`} aria-hidden="true">
                  <Fragment set:html={s.spec} />
                </div>
                {IMAGES[s.id]?.src && (
                  <img class="fg-photo" src={tileSrc(IMAGES[s.id].src)} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.hidden=true" />
                )}
              </div>
              <p class="fg-tile-label">{s.name}</p>
              <button type="button" class="fg-tile-hit" data-open={s.id} aria-haspopup="dialog">
                <span class="sr-only">Open {s.name}: example, traits, prompt and references</span>
              </button>
              <template class="fg-tpl">
                {IMAGES[s.id]?.src && (
                  <figure class="fg-ex">
                    <a class="fg-ex-img" href={IMAGES[s.id].page} target="_blank" rel="noopener noreferrer">
                      <img src={IMAGES[s.id].src} width={IMAGES[s.id].w} height={IMAGES[s.id].h} alt={`${IMAGES[s.id].title}${IMAGES[s.id].by ? ", " + IMAGES[s.id].by : ""}: an example of ${s.name}`} decoding="async" referrerpolicy="no-referrer" />
                    </a>
                    <figcaption>
                      <b>{IMAGES[s.id].title}</b>{IMAGES[s.id].date && <>, {IMAGES[s.id].date}</>}.
                      <span class="fg-credit">
                        {IMAGES[s.id].by}.{" "}
                        {IMAGES[s.id].licUrl ? <a href={IMAGES[s.id].licUrl} target="_blank" rel="noopener noreferrer">{IMAGES[s.id].lic}</a> : IMAGES[s.id].lic},
                        via <a href={IMAGES[s.id].page} target="_blank" rel="noopener noreferrer">Wikimedia Commons ↗</a>
                      </span>
                    </figcaption>
                  </figure>
                )}
                <p class="fg-plate">{groupName[s.group]}</p>
                <h3 class="fg-d-name">{s.name}</h3>
                <p class="fg-see"><span>{IMAGES[s.id]?.src ? "What to look at" : "About this plate"}</span>{IMAGES[s.id]?.see}</p>
                {IMAGES[s.id]?.vs && (
                  <div class="fg-vs">
                    <span>Don't confuse it with</span>
                    <button type="button" class="fg-vs-link" data-goto={IMAGES[s.id].vs[0]}>{nameOf[IMAGES[s.id].vs[0]]} →</button>
                    <p>{IMAGES[s.id].vs[1]}</p>
                  </div>
                )}
                <p class="fg-traits"><span>In the article</span>{s.traits}</p>
                <p class="fg-use"><span>Use it for</span>{s.use}</p>
                <div class="fg-mini"><span>As a layout</span><div class="fg-mini-slot"></div></div>
                <div class="fg-prompt">
                  <div class="fg-prompt-head"><span>Prompt</span><button type="button" class="fg-copy">Copy prompt</button></div>
                  <p class="fg-prompt-text">{s.prompt}</p>
                </div>
                {s.refs.length > 0 && (
                  <div class="fg-refs">
                    <span>See real examples</span>
                    <ul>
                      {s.refs.map((r) => (
                        <li><a href={r.url} target="_blank" rel="noopener noreferrer">{r.site} ↗</a> {r.note}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </template>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="fg-foot">
      <p>
        Source: <a href={SOURCE.url} target="_blank" rel="noopener noreferrer">{SOURCE.author}, “{SOURCE.title}”, {SOURCE.publication}, {SOURCE.date}</a>.
        Reference links come from my <a href="/design-source-catalogue">Design Source Catalogue</a>, where each style can also be filtered by source.
        Example images come from Wikimedia Commons under public-domain or Creative Commons licences, credited on each plate.
        The small layouts are drawn in code for this page; the comparisons, “Use it for” notes and prompts are mine.
      </p>
      <a class="fg-top" href="#top">Back to top ↑</a>
    </footer>

    <dialog class="fg-view" aria-labelledby="fg-view-title">
      <div class="fg-view-bar">
        <button type="button" class="fg-view-nav" data-step="-1">← <span>Previous</span></button>
        <span class="fg-view-pos" aria-live="polite"></span>
        <button type="button" class="fg-view-nav" data-step="1"><span>Next</span> →</button>
        <button type="button" class="fg-view-close" data-close>Close ✕</button>
      </div>
      <div class="fg-view-body">
        <div class="fg-view-spec"></div>
        <div class="fg-view-info"></div>
      </div>
    </dialog>
  </div>

  <script>
    const tiles = [...document.querySelectorAll(".fg-tile")];
    const sections = [...document.querySelectorAll("[data-group-section]")];
    const q = document.getElementById("fg-q");
    const count = document.getElementById("fg-count");
    const empty = document.getElementById("fg-empty");
    const state = { q: "", group: "all", order: "n" };

    function apply() {
      const term = state.q.trim().toLowerCase();
      let shown = 0;
      tiles.forEach((t) => {
        const ok = (state.group === "all" || t.dataset.group === state.group) && (!term || t.dataset.text.includes(term));
        t.hidden = !ok;
        if (ok) shown++;
      });
      sections.forEach((s) => {
        const grid = s.querySelector(".fg-grid");
        const items = [...grid.children];
        items.sort((a, b) => (state.order === "az" ? a.dataset.name.localeCompare(b.dataset.name) : a.dataset.n - b.dataset.n));
        items.forEach((i) => grid.appendChild(i));
        s.hidden = !items.some((i) => !i.hidden);
      });
      count.textContent = `${shown} of ${tiles.length} styles`;
      empty.hidden = shown > 0;
      document.querySelectorAll("button[data-group]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.group === state.group)));
      document.querySelectorAll("button[data-order]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.order === state.order)));
    }
    const clearFilters = () => { if (state.q || state.group !== "all") { state.q = ""; state.group = "all"; q.value = ""; apply(); } };

    q.addEventListener("input", () => { state.q = q.value; apply(); });
    document.querySelectorAll("button[data-group]").forEach((b) => b.addEventListener("click", () => { state.group = b.dataset.group; apply(); }));
    document.querySelectorAll("button[data-order]").forEach((b) => b.addEventListener("click", () => { state.order = b.dataset.order; apply(); }));
    // Family rows in the header: open one to filter the grid to it and list its styles; close it to show all again.
    const famBtns = [...document.querySelectorAll(".fg-fam-btn")];
    famBtns.forEach((b) => b.addEventListener("click", () => {
      const opening = b.getAttribute("aria-expanded") !== "true";
      famBtns.forEach((o) => { o.setAttribute("aria-expanded", "false"); o.nextElementSibling.hidden = true; });
      if (opening) { b.setAttribute("aria-expanded", "true"); b.nextElementSibling.hidden = false; }
      state.group = opening ? b.dataset.fam : "all"; apply();
    }));

    // ---- plate view ----
    const view = document.querySelector(".fg-view");
    const vSpec = view.querySelector(".fg-view-spec");
    const vInfo = view.querySelector(".fg-view-info");
    const vPos = view.querySelector(".fg-view-pos");
    let current = null, opener = null;

    const visible = () => tiles.filter((t) => !t.hidden).sort((a, b) =>
      (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);

    function show(tile) {
      current = tile;
      const spec = tile.querySelector(".fg-spec").cloneNode(true);
      spec.setAttribute("role", "img");
      spec.setAttribute("aria-label", `Specimen of ${tile.dataset.name} as a layout, drawn for this guide`);
      spec.removeAttribute("aria-hidden");
      const frag = tile.querySelector(".fg-tpl").content.cloneNode(true);
      const ex = frag.querySelector(".fg-ex");
      const mini = frag.querySelector(".fg-mini");
      if (ex) {
        // Real example on the left; the drawn specimen becomes a small "as a layout" sketch.
        mini.querySelector(".fg-mini-slot").append(spec);
        vSpec.replaceChildren(ex, mini);
        const img = ex.querySelector("img");
        img.addEventListener("error", () => { vSpec.replaceChildren(spec.cloneNode(true)); mini.hidden = true; }, { once: true });
      } else {
        vSpec.replaceChildren(spec);
        mini.remove();
      }
      vInfo.replaceChildren(frag);
      const title = vInfo.querySelector(".fg-d-name");
      title.id = "fg-view-title"; title.tabIndex = -1;
      vInfo.querySelectorAll(".fg-vs-link").forEach((b) => b.addEventListener("click", () => {
        const t = document.getElementById(`style-${b.dataset.goto}`);
        if (t) { clearFilters(); show(t); vInfo.querySelector(".fg-d-name").focus({ preventScroll: true }); }
      }));
      const list = visible(), i = list.indexOf(tile);
      vPos.textContent = `${i + 1} of ${list.length}`;
      view.querySelectorAll(".fg-view-nav").forEach((b) => (b.disabled = list.length < 2));
      vInfo.scrollTop = 0; vSpec.scrollTop = 0; view.querySelector(".fg-view-body").scrollTop = 0;
      try { history.replaceState(null, "", `#style-${tile.dataset.id}`); } catch {}
    }
    function open(tile, from) {
      opener = from || null;
      show(tile);
      if (!view.open) view.showModal();
    }
    function step(d) {
      const list = visible(); if (!list.length) return;
      const i = list.indexOf(current);
      show(list[(i + d + list.length) % list.length]);
    }

    document.querySelectorAll(".fg-tile-hit").forEach((b) => b.addEventListener("click", () => open(b.closest(".fg-tile"), b)));
    view.querySelectorAll(".fg-view-nav").forEach((b) => b.addEventListener("click", () => step(+b.dataset.step)));
    view.querySelector("[data-close]").addEventListener("click", () => view.close());
    view.addEventListener("click", (e) => { if (e.target === view) view.close(); });
    view.addEventListener("keydown", (e) => {
      if (e.target.closest("input, textarea")) return;
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
    });
    view.addEventListener("close", () => {
      try { history.replaceState(null, "", location.pathname + location.search); } catch {}
      const back = current && current.querySelector(".fg-tile-hit");
      (back || opener)?.focus();
    });

    // Style links in the header box open the plate directly
    document.querySelectorAll(".fg-az-link").forEach((a) => a.addEventListener("click", (e) => {
      e.preventDefault();
      const t = document.getElementById(a.getAttribute("href").slice(1));
      if (t) open(t, a);
    }));

    // Copy prompt (inside the plate view)
    view.addEventListener("click", async (e) => {
      const btn = e.target.closest(".fg-copy"); if (!btn) return;
      const textEl = vInfo.querySelector(".fg-prompt-text");
      const done = (msg) => { btn.textContent = msg; setTimeout(() => (btn.textContent = "Copy prompt"), 1800); };
      try { await navigator.clipboard.writeText(textEl.textContent.trim()); done("Copied"); }
      catch {
        const r = document.createRange(); r.selectNodeContents(textEl);
        const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
        done("Selected: press Ctrl/⌘ C");
      }
    });

    // Open a plate from a shared link like /design/styles#style-bauhaus
    const openFromHash = () => {
      const t = location.hash && document.getElementById(location.hash.slice(1));
      if (t && t.classList.contains("fg-tile")) { clearFilters(); open(t); }
    };
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  </script>
</MainLayout>


<style is:global>
  /* FIELD GUIDE · tokens
     Layout: a naturalist's field guide. A cool white cover with a red League Gothic title, a sticky key,
     then plates grouped like families, each with a drawn specimen above its field notes. */
  .fg {
    /* palette 3B, from the "Inner Weather" spread: lilac-grey page, white cover, signal red */
    --warm: #f1a7ab;       /* pale red: active chips, key underlines */
    --warm-deep: #151515;  /* eyebrow, prompt rule */
    --page: #dcdbe3;       /* lilac-grey page */
    --plate: #f3f2f2;      /* cool white: cover, tiles, plate view */
    --ink: #151515;
    --muted: #57565e;
    --maroon: #d92c36;     /* signal red: title, group labels, links and focus */
    --rule: #c9c7d2;
    --display: "Gloock", Georgia, serif;
    --body: "Josefin Sans", "Gill Sans", "Trebuchet MS", sans-serif;
    --mono: "Courier Prime", "Courier New", monospace;
  }
  html body:has(.fg) { background: #dcdbe3; overflow-x: hidden; display: flex; flex-direction: column; min-height: 100vh; }
  /* on this page the site links sit at the bottom instead of over the cover */
  html body:has(.fg) .main-content { order: 1; width: 100%; }
  html body:has(.fg) .archive-nav { order: 2; position: static; top: auto; right: auto; padding: 28px max(16px, 4vw) 44px; border-top: 1px solid #c9c7d2; }
  @media (min-width: 769px) { html body:has(.fg) .nav-links { display: flex; flex-wrap: wrap; gap: 10px; } }
  html body .main-content:has(.fg) { max-width: none; padding: 0; }
  .fg { color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.5; }
  .fg *, .fg *::before, .fg *::after { box-sizing: border-box; }
  .fg h1, .fg h2, .fg h3 { border: 0; padding: 0; margin: 0; font-family: var(--display); font-weight: 400; text-wrap: balance; }
  .fg a { color: var(--ink); text-underline-offset: 3px; }
  .fg a:hover { color: var(--maroon); }
  .fg :focus-visible { outline: 3px solid var(--maroon); outline-offset: 2px; }
  .fg button { font: inherit; }
  .fg [hidden] { display: none !important; }
  .fg { overflow-x: clip; }
  .fg .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .fg-spec img { display: block; max-width: 100%; height: auto; }
  .fg-cover, .fg-tools, .fg-group, .fg-foot, .fg-empty { padding-left: max(16px, 4vw); padding-right: max(16px, 4vw); }

  /* cover */
  .fg-cover { display: grid; grid-template-columns: 260px minmax(0, 1fr); margin: 16px max(16px, 3vw) 18px; padding: 0 !important; border: 1px solid rgba(226,38,46,.45); background: #ece8ed; color: var(--maroon); }
  .fg-side { display: flex; flex-direction: column; gap: 14px; padding: 20px 18px 18px 14px; border-right: 1px solid rgba(226,38,46,.45); font: 13px/1.35 var(--mono); color: var(--muted); }
  .fg-side b { display: block; font-weight: 700; color: var(--ink); }
  .fg .fg-back { font: 700 13px var(--mono); color: var(--ink); text-decoration: none; align-self: flex-start; }
  .fg .fg-back:hover, .fg .fg-xlink a:hover { color: var(--maroon); }
  .fg .fg-xlink a { color: var(--maroon); font-weight: 700; text-underline-offset: 3px; }
  .fg-main { display: flex; align-items: flex-start; justify-content: space-between; gap: 40px 56px; padding: 34px 34px 38px clamp(22px, 3.4vw, 56px); min-width: 0; }
  .fg-tblock { display: inline-block; min-width: 0; }
  .fg-cover h1 { position: relative; isolation: isolate; font-family: "League Gothic", "Archivo", sans-serif; text-transform: uppercase; font-size: clamp(5.4rem, 11vw, 11.2rem); line-height: 0.84; letter-spacing: 0.004em; color: var(--maroon); }
  .fg-cover h1 span { display: block; white-space: nowrap; }
  .fg-cover h1::before { content: ""; position: absolute; z-index: -1; width: .92em; height: .92em; border-radius: 50%; background: var(--warm); left: 2.2em; top: .32em; }
  .fg-sub { width: 0; min-width: 66.6%; margin: 20px 0 0; font-size: 17.5px; line-height: 1.45; color: var(--maroon); }
  .fg-azbox { flex: 0 0 300px; align-self: center; border: 1px solid rgba(226,38,46,.45); background: rgba(255,255,255,.35); padding: 16px 18px 14px; display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .fg-azbox-h { font: 400 19px/1.1 var(--display); padding-bottom: 8px; border-bottom: 1.5px solid var(--ink); }

  /* tools + index */
  /* search bar only, on the page colour */
  .fg-tools { position: sticky; top: 0; z-index: 20; background: var(--page); padding-top: 10px; padding-bottom: 12px; }
  .fg-search { display: block; }
  .fg-search input { width: 100%; font: 15px var(--body); padding: 10px 14px; border: 1px solid rgba(226,38,46,.45); border-radius: 0; background: var(--plate); color: var(--ink); }
  .fg-search input:focus-visible { outline: 2px solid var(--maroon); outline-offset: 0; }
  /* header box: families that open into style links (mirrors the catalogue's style box) */
  .fg-fams { display: flex; flex-direction: column; }
  .fg-fam-btn { display: flex; justify-content: space-between; align-items: baseline; width: 100%; text-align: left; background: none; border: 0; padding: 5px 0; cursor: pointer; font: 14.5px var(--body); color: var(--ink); }
  .fg-fam-btn::after { content: "+"; font-size: 17px; line-height: 1; color: var(--muted); }
  .fg-fam-btn[aria-expanded="true"] { font-weight: 600; }
  .fg-fam-btn[aria-expanded="true"]::after { content: "–"; }
  .fg-fam-btn .n { margin-left: auto; margin-right: 12px; font: 12.5px var(--mono); color: var(--muted); }
  .fg-fam-list { display: flex; flex-wrap: wrap; gap: 5px; padding: 6px 0 8px; }
  .fg .fg-az-link { background: #fff; border: 1px solid #d3d3cc; padding: 4px 9px; font-size: 13px; text-decoration: none; color: var(--ink); }
  .fg .fg-az-link:hover { background: var(--ink); color: #fff; border-color: var(--ink); }
  .fg-empty { margin: 30px 0 0; font-size: 18px; }

  /* groups: compact specimen drawers */
  .fg-group { padding-top: 40px; padding-bottom: 4px; scroll-margin-top: 110px; }
  .fg-group-head { display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: baseline; border-bottom: 2px solid var(--ink); padding-bottom: 8px; margin-bottom: 18px; }
  .fg-group-head h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1; }
  .fg-group-head p { margin: 0; color: var(--muted); max-width: 60ch; flex: 1 1 260px; }
  .fg-group-count { font: 12px var(--mono); color: var(--muted); margin-left: auto; }

  /* tiles: every plate the same size, so rows stay even */
  .fg-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1100px) { .fg-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .fg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; } }
  @media (max-width: 520px) { .fg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .fg-tile { container-type: inline-size; position: relative; display: grid; gap: 0; background: var(--plate); border: 1px solid var(--rule); min-width: 0; transition: transform .2s ease, box-shadow .2s ease; }
  .fg-tile:hover { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(5,22,46,.14); }
  .fg-tile:focus-within { outline: 3px solid var(--maroon); outline-offset: 2px; }
  .fg-tile-label { margin: 0; padding: 8px 10px 9px; font: 400 1.02rem/1.15 var(--display); border-top: 1px solid var(--rule); min-height: 2.7em; display: flex; gap: 8px; align-items: baseline; }
  .fg-tile-hit { position: absolute; inset: 0; width: 100%; background: none; border: 0; padding: 0; cursor: zoom-in; z-index: 3; }
  .fg-tile-hit:focus-visible { outline: none; }
  .fg-media { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--plate); }
  .fg-media .fg-spec { position: absolute; inset: 0; }
  .fg-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .fg-tile:hover .fg-photo { transform: scale(1.04); }

  /* plate view (dialog) */
  .fg-view { border: 0; padding: 0; width: min(1080px, 94vw); max-height: 92vh; background: var(--page); color: var(--ink); box-shadow: 0 30px 80px rgba(5,22,46,.4); overflow: hidden; }
  .fg-view[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .fg-view::backdrop { background: rgba(5,22,46,.72); }
  .fg-view-bar { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--ink); color: var(--page); }
  .fg-view-bar button { font: 13px var(--mono); background: transparent; color: var(--page); border: 1px solid rgba(241,167,171,.75); border-radius: 999px; padding: 6px 12px; cursor: pointer; }
  .fg-view-bar button:hover { background: var(--warm); color: var(--ink); }
  .fg-view-bar button:disabled { opacity: .4; cursor: default; }
  .fg-view-pos { font: 13px var(--mono); color: var(--warm); min-width: 7ch; text-align: center; }
  .fg-view-close { margin-left: auto; }
  .fg-view-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 0; }
  .fg-view-spec { container-type: inline-size; border-right: 1px solid var(--rule); background: var(--plate); display: grid; align-content: start; overflow-y: auto; }
  .fg-view-spec .fg-spec { aspect-ratio: 1; width: 100%; }
  .fg-ex { margin: 0; display: grid; }
  .fg-ex-img { display: grid; place-items: center; background: #2a2420; min-height: 260px; }
  .fg-ex-img img { display: block; max-width: 100%; height: auto; max-height: min(64vh, 640px); width: auto; object-fit: contain; }
  .fg-ex figcaption { padding: 10px 14px 14px; font-size: 13.5px; line-height: 1.45; color: var(--muted); }
  .fg-ex figcaption b { color: var(--ink); font-weight: 600; }
  .fg-credit { display: block; margin-top: 3px; font: 12px/1.5 var(--mono); }
  .fg-credit a, .fg-ex figcaption a { color: var(--ink); }
  .fg-see, .fg-vs p { margin: 0; font-size: 15.5px; max-width: 52ch; }
  .fg-see span, .fg-vs > span, .fg-mini > span { display: block; font: 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .fg-vs { border-left: 3px solid var(--maroon); padding: 4px 0 4px 12px; display: grid; gap: 4px; justify-items: start; }
  .fg-vs-link { font: 400 1.25rem/1.1 var(--display); color: var(--maroon); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  .fg-vs-link:hover { text-decoration: underline; }
  .fg-mini { display: grid; gap: 4px; padding: 0 14px 16px; }
  .fg-d-name:focus { outline: none; }
  .fg-mini-slot { width: 132px; border: 1px solid var(--rule); container-type: inline-size; }
  .fg-mini-slot .fg-spec { aspect-ratio: 1; width: 100%; }
  .fg-view-info { overflow-y: auto; padding: 22px 24px 26px; display: grid; gap: 14px; align-content: start; }
  .fg-plate { margin: 0; font: 12px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--maroon); }
  .fg-d-name { font-size: clamp(1.9rem, 3.4vw, 2.8rem); line-height: 1; }
  .fg-traits, .fg-use { margin: 0; font-size: 15.5px; max-width: 52ch; }
  .fg-traits span, .fg-use span, .fg-refs > span, .fg-prompt-head span { display: block; font: 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .fg-prompt { background: var(--plate); border: 1px solid var(--rule); border-left: 3px solid var(--warm-deep); padding: 10px 12px 12px; display: grid; gap: 6px; }
  .fg-prompt-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .fg-prompt-head span { margin: 0; }
  .fg-prompt-text { margin: 0; font: 13.5px/1.55 var(--mono); }
  .fg-copy { font: 700 12.5px var(--mono); background: var(--ink); color: var(--page); border: 0; padding: 6px 10px; cursor: pointer; }
  .fg-copy:hover { background: var(--maroon); }
  .fg-refs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
  .fg-refs a { font-weight: 600; color: var(--ink); }

  .fg-foot { padding-top: 56px; padding-bottom: 72px; font-size: 14.5px; display: grid; gap: 14px; }
  .fg-foot p { margin: 0; max-width: 75ch; }
  .fg-top { position: fixed; right: max(16px, 2vw); bottom: max(16px, 2vw); z-index: 25; background: var(--ink); color: var(--page) !important; padding: 9px 12px; font: 13px var(--mono); text-decoration: none; }

  /* ===================== SPECIMENS =====================
     Each plate is a small original drawing in HTML/CSS/SVG. Sizes use container units. */
  .fg-spec { position: relative; overflow: hidden; aspect-ratio: 1; container-type: inline-size; isolation: isolate; display: grid; place-items: center; text-align: center; }
  .fg-spec b, .fg-spec small { position: relative; z-index: 2; }
  .fg-spec svg { fill: none; stroke: currentColor; }

  .sp-neoclassical { background: repeating-linear-gradient(115deg, rgba(120,110,95,.06) 0 2px, transparent 2px 40px), linear-gradient(160deg, #f3f1ea, #dcd7cb); color: #2c3440; }
  .sp-neoclassical .col { position: absolute; top: 6%; bottom: 6%; left: 8%; width: 14%; background: repeating-linear-gradient(90deg, #e9e5da 0 4px, #cfc8b8 4px 6px); border-top: 6px solid #cfc8b8; border-bottom: 6px solid #cfc8b8; }
  .sp-neoclassical .col.r { left: auto; right: 8%; }
  .sp-neoclassical .mid { display: grid; gap: 2cqw; }
  .sp-neoclassical b { font: 700 10cqw "Cinzel", serif; letter-spacing: .08em; }
  .sp-neoclassical small { font: 500 4cqw "Cinzel", serif; letter-spacing: .3em; color: #9a7b3f; }
