  .sp-baroque b { font: 400 17cqw "Pinyon Script", cursive; line-height: 1; background: linear-gradient(180deg, #fff1b8, #c99a3c 55%, #7a5418); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sp-baroque small { font: 700 3.6cqw "Cinzel", serif; letter-spacing: .35em; }

  .sp-aurora { background: #070b22; color: #f2fbff; }
